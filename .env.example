# Instagram / Meta Webhook Verification Token (any random string of your choice)
VERIFY_TOKEN=insta_bot_secret_token_123

# Meta / Facebook Page Access Token (From developers.facebook.com)
PAGE_ACCESS_TOKEN=your_page_access_token_here

# Keyword to listen for in comments (e.g. LINK, SEND, GUIDE, INFO). Case-insensitive.
TRIGGER_KEYWORD=LINK

# The link you want to send in DM
LINK_TO_SEND=https://yourwebsite.com/my-resource

# The DM message sent to the user
DM_MESSAGE_TEMPLATE=Hey @{username}! Here is the direct link you asked for: {link} 🚀\nEnjoy!

# Public reply to the comment under your Reel (Leave blank if you don't want public reply)
COMMENT_REPLY_TEMPLATE=Check your DM! I've sent you the link. ✅
